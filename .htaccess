# ==============================================================================
# One Corporate Building Maintenance Manager - Apache / cPanel Web Configuration
# ==============================================================================

# 1. Enable iframe embedding for same-origin sub-pages (Maintenance Procedures, Guidelines, Inventory)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self';"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. Proper MIME Types
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType image/webp .webp
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# 4. GZIP Compression for Fast Web Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Prevent directory index listing while allowing direct file access
Options -Indexes
